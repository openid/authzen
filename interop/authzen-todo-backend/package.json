{
  "name": "authzen-todo-backend",
  "version": "0.1.22",
  "description": "AuthZEN todo backend interop sample",
  "main": "src/index.ts",
  "scripts": {
    "build": "yarn clean && tsc",
    "clean": "rm -rf ./build",
    "start": "node build/src/index.js",
    "dev": "nodemon --ignore db/* ./src/index.ts",
    "docker-build": "scripts/docker-build.sh",
    "docker-run": "scripts/docker-run.sh",
    "gcp-build": "scripts/build-gcp.sh",
    "gcp-deploy": "scripts/deploy-gcp.sh",
    "tsc": "tsc --noEmit --incremental",
    "release": "./scripts/release.sh",
    "test": "node build/test/runner.js",
    "test-clean": "yarn build && yarn test"
  },
  "keywords": [],
  "author": "Omri Gazitt <ogazitt@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.1",
    "cli-color": "^2.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "express": "^5.2.1",
    "express-jwt": "8.5.1",
    "jwks-rsa": "4.1.0",
    "lodash": "^4.18.1",
    "node-fetch": "^3.3.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/cli-color": "^2.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/sqlite3": "^5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@1.22.19"
}
