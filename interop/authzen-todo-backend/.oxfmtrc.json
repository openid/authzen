{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "quoteProps": "preserve",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".github/**",
    ".vscode/**",
    "test/*.json",
    "db/**",
    "build/**"
  ]
}
